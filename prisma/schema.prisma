
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL өгөгдлийн сан
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Зохиогчийн мэдээлэл
model Author {
  // Зохиогчийн ID
  id    Int    @id @default(autoincrement())

  // Зохиогчийн нэр
  name  String

  // Давтагдахгүй имэйл
  email String @unique

  // Нэг зохиогч олон номтой
  books Book[]
}

// Номын мэдээлэл
model Book {
  // Номын ID
  id          Int      @id @default(autoincrement())

  // Номын нэр
  title       String

  // Семинар 5-ын зохиогчийн нэрийг түр хадгална
  authorName  String?  @map("author")

  // Номын үнэ
  price       Int

  // Ном байгаа эсэх
  isAvailable Boolean  @default(true)

  // Ном нэмсэн огноо
  createdAt   DateTime @default(now())

  // Зохиогчийн ID - түр заавал биш
  authorId    Int?

  // Зохиогчтой холбох
  author      Author?  @relation(fields: [authorId], references: [id])
}
